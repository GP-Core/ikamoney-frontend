# Copia este archivo como .env y ajusta los valores.
# Solo las variables que empiezan con VITE_ llegan al navegador.

# URL del backend (ikamoney-backend), sin /api al final. DÉJALA VACÍA: el frontend llama a /api en su propio
# origen (el proxy de Vite en desarrollo y el rewrite de vercel.json en producción lo reenvían al backend), y así
# la cookie de sesión HttpOnly es del mismo sitio. Solo con un backend en otro origen se pone su dirección, y
# entonces el backend debe tener TOKEN_EN_RESPUESTA=true (transición, menos seguro).
VITE_API_URL=

# Pantalla principal: true = datos de ejemplo (demo, sin backend); false = usa GET /api/v1/balance (T33)
VITE_USAR_DATOS_EJEMPLO=true

# Pantalla de score (T37, /?score): true = datos simulados de la hoja de T26; false = usa GET /api/v1/score
VITE_SCORE_USAR_EJEMPLO=true

# Modo de prueba de la autenticación (T51).
# true  = el registro, login y recuperación funcionan sin backend (datos en el navegador).
# false = se usan los endpoints reales /api/auth/* del backend.
VITE_AUTH_MOCK=true

# Pantalla de plan de pago (/plan): true = respuesta de ejemplo; false = GET /api/v1/priorizador (T43 + T45)
VITE_PLAN_USAR_EJEMPLO=true

# Simulador de compras (/simulador): true = resultado simulado en el navegador; false = endpoint de Daniel
VITE_SIMULADOR_USAR_EJEMPLO=true


# Ranking de deudas (/ranking): true = respuesta de ejemplo; false = GET /api/v1/priorizador (T43)
VITE_RANKING_USAR_EJEMPLO=true

# Notificaciones push (T50): llave pública VAPID. Sin ella la opción de push aparece como "próximamente"
# (en modo de prueba, VITE_AUTH_MOCK=true, sí se puede probar el permiso del navegador).
VITE_VAPID_PUBLIC_KEY=
