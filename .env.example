# Copia este archivo como .env y ajusta los valores.
# Solo las variables que empiezan con VITE_ llegan al navegador.

# URL del backend (ikamoney-backend), sin /api al final
VITE_API_URL=http://localhost:8000

# Modo de prueba de la autenticación (T51).
# true  = el registro, login y recuperación funcionan sin backend (datos en el navegador).
# false = se usan los endpoints reales /api/auth/* del backend.
VITE_AUTH_MOCK=true