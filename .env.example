# Copia este archivo como .env y ajusta los valores.
# Solo las variables que empiezan con VITE_ llegan al navegador.

# URL del backend (ikamoney-backend), sin /api al final
VITE_API_URL=http://localhost:8000

# Pantalla principal: true = datos de ejemplo (demo, sin backend); false = usa GET /api/v1/balance (T33)
VITE_USAR_DATOS_EJEMPLO=true

# Pantalla de score (T37, /?score): true = datos simulados de la hoja de T26; false = usa GET /api/v1/score
VITE_SCORE_USAR_EJEMPLO=true
