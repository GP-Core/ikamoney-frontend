# Copia este archivo como .env y ajusta los valores.
# Solo las variables que empiezan con VITE_ llegan al navegador.

# URL del backend (ikamoney-backend), sin /api al final
VITE_API_URL=http://localhost:8000

# Pantalla principal: true = datos de ejemplo (demo, sin backend); false = usa GET /api/v1/balance (T33)
VITE_USAR_DATOS_EJEMPLO=true

# Pantalla de score (T37, /?score): true = datos simulados de la hoja de T26; false = usa GET /api/v1/score
VITE_SCORE_USAR_EJEMPLO=true

# Modo de prueba de la autenticación (T51).
# true  = el registro, login y recuperación funcionan sin backend (datos en el navegador).
# false = se usan los endpoints reales /api/auth/* del backend.
VITE_AUTH_MOCK=true

# Pantalla de plan de pago (/plan): true = respuesta de ejemplo; false = GET /api/v1/priorizador (T43 + T45)
VITE_PLAN_USAR_EJEMPLO=true
